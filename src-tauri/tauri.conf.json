{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "TuxCodex",
  "version": "0.1.0",
  "identifier": "dev.tuxcodex.desktop",
  "build": {
    "beforeDevCommand": "npm run dev",
    "devUrl": "http://127.0.0.1:1420",
    "beforeBuildCommand": "npm run build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "title": "TuxCodex",
        "width": 1200,
        "height": 800,
        "minWidth": 800,
        "minHeight": 560,
        "backgroundColor": "#0d1117"
      }
    ],
    "security": {
      "csp": "default-src 'self'; img-src 'self' data:; style-src 'self' 'unsafe-inline'; connect-src ipc: http://ipc.localhost"
    }
  },
  "bundle": {
    "active": true,
    "targets": ["deb", "appimage"],
    "icon": ["icons/32x32.png", "icons/128x128.png", "icons/icon.png", "icons/icon.icns", "icons/icon.ico"],
    "shortDescription": "A Linux desktop client for Codex",
    "longDescription": "TuxCodex is an unofficial Linux desktop client that connects to the Codex app-server."
  }
}
